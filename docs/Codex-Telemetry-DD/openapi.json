{
  "openapi": "3.1.0",
  "info": {
    "title": "Codex Token Telemetry Core API",
    "version": "0.1.0",
    "description": "Design specification, not a deployed endpoint. See DD.md for identities, baseline, ordering, source coverage and transaction rules."
  },
  "paths": {
    "/v1/usage/batches": {
      "post": {
        "operationId": "ingestBatch",
        "summary": "Atomically persist one stream checkpoint batch",
        "description": "Maximum decompressed body 512 KiB. Authentication binds tenant and device; caller cannot select tenant_id. Durable acknowledgement only after database commit. Core v0.1 supports validated token_count checkpoints; unsupported formats remain partial.",
        "security": [
          {
            "DeviceWriteToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durably accepted, may be pending processing due to a gap or quality issue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ack"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting identity or immutable record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid semantic fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited; honor Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporary unavailability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/usage/summary": {
      "get": {
        "operationId": "getSummary",
        "summary": "Read all four windows with one as_of time",
        "security": [
          {
            "TenantReadToken": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "query",
            "required": false,
            "description": "Filters stream ownership, not copies of the same logs.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot of confirmed ledger totals; quality limited to registered sources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Tenant mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/devices/status": {
      "get": {
        "operationId": "getDeviceStatus",
        "security": [
          {
            "TenantReadToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Registered device coverage and queue health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Devices"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/devices/heartbeat": {
      "post": {
        "operationId": "postHeartbeat",
        "description": "Live health snapshot, not a token usage event. Recompute on retry; never replay stale heartbeats from the persistent usage queue. Device and tenant come from credential.",
        "security": [
          {
            "DeviceWriteToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Heartbeat"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Health snapshot stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeartbeatAck"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid health values",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/streams/{stream_id}/state": {
      "get": {
        "operationId": "getStreamState",
        "description": "A registered device may read state for its tenant to reuse the immutable anchor and baseline. Does not permit changing the anchor. Enrollment and registration control plane are outside this core API.",
        "security": [
          {
            "DeviceWriteToken": []
          },
          {
            "TenantReadToken": []
          }
        ],
        "parameters": [
          {
            "name": "stream_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          {
            "name": "epoch",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shared baseline and processing state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StreamState"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or unauthorized stream",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Process alive; no tenant data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DeviceWriteToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Device-scoped write credential and same-tenant stream-state reads"
      },
      "TenantReadToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Tenant-scoped read-only credential"
      }
    },
    "schemas": {
      "Counters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "cached_input",
          "output",
          "reasoning_output"
        ],
        "properties": {
          "input": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "description": "Nonnegative int64 encoded as decimal string; server enforces <= 9223372036854775807."
          },
          "cached_input": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "description": "Nonnegative int64 encoded as decimal string; server enforces <= 9223372036854775807."
          },
          "output": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "description": "Nonnegative int64 encoded as decimal string; server enforces <= 9223372036854775807."
          },
          "reasoning_output": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "description": "Nonnegative int64 encoded as decimal string; server enforces <= 9223372036854775807."
          }
        }
      },
      "Record": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "source_seq",
          "kind",
          "event_time",
          "observed_at",
          "model",
          "counters"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_seq": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "description": "Nonnegative int64 encoded as decimal string; server enforces <= 9223372036854775807."
          },
          "kind": {
            "type": "string",
            "enum": [
              "baseline",
              "snapshot"
            ]
          },
          "event_time": {
            "type": "string",
            "format": "date-time"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "baseline_reason": {
            "type": "string",
            "enum": [
              "known_zero",
              "capture_start",
              "inherited_history"
            ]
          },
          "counters": {
            "$ref": "#/components/schemas/Counters"
          }
        },
        "description": "baseline requires source_seq 0 and baseline_reason; snapshot requires seq >0 and no baseline_reason. Semantic rules enforced by server. device and observed_at are excluded from semantic hash."
      },
      "Batch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "parser_version",
          "batch_id",
          "stream_id",
          "epoch",
          "anchor_id",
          "records"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "parser_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "batch_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "stream_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "epoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "anchor_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/Record"
            }
          }
        }
      },
      "Ack": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accepted",
          "duplicates",
          "durable_through",
          "processed_through",
          "pending_gap",
          "quality",
          "quality_reasons"
        ],
        "properties": {
          "accepted": {
            "type": "integer",
            "minimum": 0
          },
          "duplicates": {
            "type": "integer",
            "minimum": 0
          },
          "durable_through": {
            "type": "string",
            "pattern": "^(-1|0|[1-9][0-9]{0,18})$"
          },
          "processed_through": {
            "type": "string",
            "pattern": "^(-1|0|[1-9][0-9]{0,18})$"
          },
          "pending_gap": {
            "type": "boolean"
          },
          "quality": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          },
          "quality_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Totals": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "cached_input",
          "output",
          "reasoning_output",
          "total"
        ],
        "properties": {
          "input": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,29})$"
          },
          "cached_input": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,29})$"
          },
          "output": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,29})$"
          },
          "reasoning_output": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,29})$"
          },
          "total": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,29})$"
          }
        }
      },
      "Window": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "start",
          "end",
          "totals"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "rolling_5h",
              "today",
              "week",
              "month"
            ]
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "totals": {
            "$ref": "#/components/schemas/Totals"
          }
        }
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "as_of",
          "timezone",
          "windows",
          "quality",
          "quality_reasons",
          "ingestion_lag_seconds"
        ],
        "properties": {
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "timezone": {
            "const": "Asia/Shanghai"
          },
          "windows": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Window"
            }
          },
          "quality": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          },
          "quality_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ingestion_lag_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "DeviceStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id",
          "status",
          "last_seen_at",
          "queued_records",
          "quality"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "revoked"
            ]
          },
          "last_seen_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "queued_records": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "description": "Nonnegative int64 encoded as decimal string; server enforces <= 9223372036854775807."
          },
          "quality": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          }
        }
      },
      "Devices": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "devices"
        ],
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceStatus"
            }
          }
        }
      },
      "Heartbeat": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queued_records",
          "oldest_queued_at",
          "last_scan_at",
          "quality",
          "quality_reasons"
        ],
        "properties": {
          "queued_records": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "description": "Nonnegative int64 encoded as decimal string; server enforces <= 9223372036854775807."
          },
          "oldest_queued_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_scan_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "quality": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          },
          "quality_reasons": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "enum": [
                "scan_failed",
                "unsupported_usage",
                "unknown_identity",
                "clock_anomaly",
                "queue_full",
                "paused",
                "source_missing",
                "parse_failed"
              ]
            }
          }
        }
      },
      "HeartbeatAck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "received_at"
        ],
        "properties": {
          "received_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StreamState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stream_id",
          "epoch",
          "anchor_id",
          "baseline_reason",
          "baseline_event",
          "durable_through",
          "processed_through",
          "quality",
          "quality_reasons"
        ],
        "properties": {
          "stream_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "epoch": {
            "type": "integer",
            "minimum": 0
          },
          "anchor_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "baseline_reason": {
            "type": "string",
            "enum": [
              "known_zero",
              "capture_start",
              "inherited_history"
            ]
          },
          "baseline_event": {
            "$ref": "#/components/schemas/Record"
          },
          "durable_through": {
            "type": "string",
            "pattern": "^(-1|0|[1-9][0-9]{0,18})$"
          },
          "processed_through": {
            "type": "string",
            "pattern": "^(-1|0|[1-9][0-9]{0,18})$"
          },
          "quality": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          },
          "quality_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}